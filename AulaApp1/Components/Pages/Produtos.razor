@page "/produtos"
@using AulaApp1.Components.Models
@using AulaApp1.Components

<h3>Produtos</h3>

<div class="row">
    <div class="col-md-4">
        <FormProduto OnProdutoAdicionado="AdicionarProdutoNaLista" />
    </div>
    <div class="col-md-8">
        <TabelaProdutos Produtos="produtos" />
    </div>
</div>

@code {
    private List<Produto> produtos = new();

    private void AdicionarProdutoNaLista(Produto novoProduto)
    {
        produtos.Add(new Produto
        {
            Nome = novoProduto.Nome,
            Preco = novoProduto.Preco,
            Quantidade = novoProduto.Quantidade
        });
    }
}