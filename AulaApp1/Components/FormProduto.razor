@using AulaApp1.Components.Models

<Cartao Titulo="Cadastrar Produto">
    <EditForm Model="produtoModel" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Nome</label>
            <InputText class="form-control" @bind-Value="produtoModel.Nome" />
            <ValidationMessage For="() => produtoModel.Nome" />
        </div>

        <div class="mb-3">
            <label class="form-label">Preço</label>
            <InputNumber class="form-control" @bind-Value="produtoModel.Preco" />
            <ValidationMessage For="() => produtoModel.Preco" />
        </div>

        <div class="mb-3">
            <label class="form-label">Quantidade</label>
            <InputNumber class="form-control" @bind-Value="produtoModel.Quantidade" />
            <ValidationMessage For="() => produtoModel.Quantidade" />
        </div>

        <button type="submit" class="btn btn-primary">Adicionar produto</button>
    </EditForm>
</Cartao>

@code {
    private Produto produtoModel = new();

    [Parameter]
    public EventCallback<Produto> OnProdutoAdicionado { get; set; }

    private async Task HandleValidSubmit()
    {
        await OnProdutoAdicionado.InvokeAsync(produtoModel);

        produtoModel = new Produto();
    }
}